# Quick check: read model metadata from GGUF
import struct, os, sys

def read_gguf_meta(path):
    with open(path, 'rb') as f:
        magic = f.read(4)
        if magic != b'GGUF':
            return {'error': 'not a GGUF file'}
        version = struct.unpack('<I', f.read(4))[0]
        n_tensors = struct.unpack('<Q', f.read(8))[0]
        n_kv = struct.unpack('<Q', f.read(8))[0]
        meta = {}
        for i in range(n_kv):
            klen = struct.unpack('<I', f.read(4))[0]
            key = f.read(klen).decode('utf-8')
            ktype = struct.unpack('<I', f.read(4))[0]
            if ktype == 0:  # uint8
                val = struct.unpack('B', f.read(1))[0]
            elif ktype == 1:  # int8
                val = struct.unpack('b', f.read(1))[0]
            elif ktype == 2:  # uint16
                val = struct.unpack('<H', f.read(2))[0]
            elif ktype == 3:  # int16
                val = struct.unpack('<h', f.read(2))[0]
            elif ktype == 4:  # uint32
                val = struct.unpack('<I', f.read(4))[0]
            elif ktype == 5:  # int32
                val = struct.unpack('<i', f.read(4))[0]
            elif ktype == 6:  # float32
                val = struct.unpack('<f', f.read(4))[0]
            elif ktype == 7:  # bool
                val = bool(struct.unpack('B', f.read(1))[0])
            elif ktype == 8:  # string
                slen = struct.unpack('<Q', f.read(8))[0]
                val = f.read(slen).decode('utf-8')
            elif ktype == 9:  # array
                arr_type = struct.unpack('<I', f.read(4))[0]
                arr_len = struct.unpack('<Q', f.read(8))[0]
                val = f'<array of {arr_len} items>'
                f.seek(0, os.SEEK_CUR)
            elif ktype == 10:  # uint64
                val = struct.unpack('<Q', f.read(8))[0]
            elif ktype == 11:  # int64
                val = struct.unpack('<q', f.read(8))[0]
            elif ktype == 12:  # float64
                val = struct.unpack('<d', f.read(8))[0]
            else:
                val = f'<unknown type {ktype}>'
            meta[key] = val
            if 'context' in key.lower() or 'ctx' in key.lower() or 'max' in key.lower() or 'n_embd' in key.lower():
                print(f'{key} = {val}')
        return meta

